# Configuración de S3 Compatible (iDrive e2, AWS S3, etc.)
# Endpoint de tu servicio S3 (sin https://)
S3_ENDPOINT=tu-endpoint.idrivee2.com

# Credenciales de acceso a S3
S3_ACCESS_KEY_ID=TU_ACCESS_KEY_AQUI
S3_SECRET_ACCESS_KEY=TU_SECRET_KEY_AQUI

# Nombre del bucket donde están almacenados los archivos MP4
S3_BUCKET_NAME=nombre-de-tu-bucket

# Entorno de ejecución (development o production)
NODE_ENV=development

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000
